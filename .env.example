TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SESSION_NAME=ahsoka_user
BOT_TOKEN=
OWNER_CHAT_ID=          # numeric user ID; get from @userinfobot
CHANNEL_IDS=            # comma-separated negative ints, e.g. -1001234567890,-1009876543210
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
DEFAULT_SCORE_THRESHOLD=7
SCRAPE_TIMEOUT_S=5.0
DB_PATH=ahsoka.db

# --- Repost detection (Voyage AI embeddings) ---
# VOYAGE_API_KEY is a Secret; the rest are Variables. Defaults live in config.py.
VOYAGE_API_KEY=         # Voyage AI; empty disables repost detection
# VOYAGE_MODEL=voyage-4-lite   # embedding model (default voyage-4-lite)
# REPOST_MODE=shadow           # off|shadow|enforce (default shadow: log only, still deliver)
# REPOST_THRESHOLD=0.95        # cosine similarity at/above which a post counts as a repost

# --- Cost reconciliation (optional) ---
# ANTHROPIC_ADMIN_KEY is a Secret. Requires an organization account with Admin API access
# (individual accounts cannot create admin keys). Empty disables reconciliation.
# The billed figure is ORG-WIDE and approximate: other API usage in the organization
# inflates drift, and it is unconfirmed whether the 50% batch discount is reflected.
ANTHROPIC_ADMIN_KEY=         # sk-ant-admin...; empty disables

# --- Batch scoring tunables (Variables, not Secrets) ---
# Defaults live in config.py; omit any of these to use the config.py default.
# BATCH_FLUSH_SIZE=50          # flush when this many per-user scoring requests are queued
# BATCH_FLUSH_SECONDS=600      # flush after this many seconds even if size threshold not reached
# BATCH_POLL_INTERVAL_SECONDS=60  # how often to poll Anthropic for batch completion
# BATCH_MAX_WAIT_SECONDS=1800  # max time to wait for a single batch before marking it failed and moving on
